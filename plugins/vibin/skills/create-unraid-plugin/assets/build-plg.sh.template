#!/bin/bash
# Assemble an Unraid .plg + its .tgz package from src/. The plugin file tree is
# tarred into <name>.tgz REPRODUCIBLY. The build also emits the exact versioned
# filename referenced by the .plg. The Unraid loader verifies MD5 for
# compatibility, then the install script verifies SHA-256 before extraction.
#
# EDIT THESE FOUR for your plugin, then commit. Everything else is derived.
set -euo pipefail
cd "$(dirname "$0")"

NAME="PLUGIN_ID"                 # lowercase-kebab, matches src/.../plugins/<NAME>/
AUTHOR="AUTHOR_NAME"
REPO="${REPO:-OWNER/PLUGIN_ID}"  # owner/name on GitHub
MIN_UNRAID="MIN_UNRAID_VERSION"  # oldest Unraid release this plugin supports

OUT="${NAME}.plg"
SRCDIR="src/usr/local/emhttp/plugins/${NAME}"
TGZ="${NAME}.tgz"

[[ "$NAME" =~ ^[a-z][a-z0-9-]*$ ]] || { echo "NAME must be lowercase kebab-case: $NAME" >&2; exit 1; }
[[ "$REPO" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || { echo "REPO must be OWNER/NAME: $REPO" >&2; exit 1; }
[[ "$MIN_UNRAID" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]] || { echo "MIN_UNRAID must be an explicit Unraid version: $MIN_UNRAID" >&2; exit 1; }
[ -n "$AUTHOR" ] && [[ "$AUTHOR" != *$'\n'* ]] && [[ "$AUTHOR" != *$'\r'* ]] || { echo "AUTHOR must be one non-empty line" >&2; exit 1; }
[ -d "$SRCDIR" ] || { echo "missing plugin source directory: $SRCDIR" >&2; exit 1; }

# Require GNU tar: silently falling back to a tar without --sort/--mtime makes
# the output non-reproducible while still looking successful.
if tar --version 2>/dev/null | grep -qi 'gnu tar'; then
  TAR_CMD=(tar)
elif command -v gtar >/dev/null 2>&1 && gtar --version 2>/dev/null | grep -qi 'gnu tar'; then
  TAR_CMD=(gtar)
else
  echo "GNU tar is required for reproducible packaging (install gtar on macOS)" >&2
  exit 1
fi

# Reproducible package: byte-identical output (=> identical MD5/SHA-256) from
# the same source. This is a plugin-directory archive: install it only with -C
# "$PLGDIR" and --no-overwrite-dir, never extract it at filesystem root.
make_tgz() {
  "${TAR_CMD[@]}" --sort=name --mtime='UTC 2020-01-01' \
    --owner=0 --group=0 --numeric-owner -cf - -C "$SRCDIR" . | gzip -9n > "$TGZ"
}

# Internal SemVer: explicit env wins, else the VERSION file, else 0.0.0 (dev).
INTERNAL_VERSION="${INTERNAL_VERSION:-$( [ -f VERSION ] && tr -d '[:space:]' < VERSION || echo '0.0.0' )}"
INTERNAL_VERSION="${INTERNAL_VERSION:-0.0.0}"
BUILD_NUMBER="${BUILD_NUMBER:-${GITHUB_RUN_NUMBER:-0}}"
DATE="${DATE:-$(date -u +%Y.%m.%d.%H%M)}"

[[ "$DATE" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}\.[0-9]{4}$ ]] || { echo "DATE must be YYYY.MM.DD.HHMM: $DATE" >&2; exit 1; }
[[ "$BUILD_NUMBER" =~ ^[0-9]+$ ]] || { echo "BUILD_NUMBER must be numeric: $BUILD_NUMBER" >&2; exit 1; }
[[ "$INTERNAL_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]] || { echo "INTERNAL_VERSION must be SemVer: $INTERNAL_VERSION" >&2; exit 1; }

# External stamp sorts chronologically in Unraid's plugin manager while pinning
# the SemVer it was cut from: YYYY.MM.DD.HHMM.BUILD-SEMVER.
VERSION="${DATE}.${BUILD_NUMBER}-${INTERNAL_VERSION}"
RELEASE_TAG="v${INTERNAL_VERSION}"
PLUGIN_URL="https://github.com/${REPO}/releases/latest/download/${NAME}.plg"   # latest => update checks find newest
SUPPORT_URL="https://github.com/${REPO}/issues"
PACKAGE_NAME="${NAME}-${VERSION}.tgz"
PACKAGE_URL="https://github.com/${REPO}/releases/download/${RELEASE_TAG}/${PACKAGE_NAME}"  # tag-pinned

md5_of() { if command -v md5sum >/dev/null 2>&1; then md5sum "$1" | cut -d' ' -f1; else md5 -q "$1"; fi; }
sha256_of() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi; }

# --tgz-only rebuilds source bytes for release verification. If a committed
# .plg exists, use its packageName so the exact upload filename is emitted too.
if [ "${1:-}" = "--tgz-only" ] && [ -f "$OUT" ]; then
  committed_name="$(sed -n 's/^<!ENTITY packageName[[:space:]]*"\([^"]*\)">$/\1/p' "$OUT")"
  [ -n "$committed_name" ] || { echo "packageName entity missing from $OUT" >&2; exit 1; }
  [[ "$committed_name" =~ ^${NAME}-[0-9A-Za-z._-]+\.tgz$ ]] || { echo "unsafe or unexpected packageName in $OUT: $committed_name" >&2; exit 1; }
  PACKAGE_NAME="$committed_name"
fi

# Changelog body for <CHANGES>: newest CHANGELOG.md section if present, else a line.
changes="- ${NAME} for Unraid."
if [ -f CHANGELOG.md ]; then
  section="$(awk '/^## /{n++; if(n==2) exit} n==1 && !/^## /' CHANGELOG.md | sed '/^[[:space:]]*$/d')"
  [ -n "$section" ] && changes="$section"
fi

make_tgz
PACKAGE_MD5="$(md5_of "$TGZ")"
PACKAGE_SHA256="$(sha256_of "$TGZ")"
cp -f "$TGZ" "$PACKAGE_NAME"

if [ "${1:-}" = "--tgz-only" ]; then
  if [ -f "$OUT" ]; then
    committed_md5="$(sed -n 's/^<!ENTITY packageMD5[[:space:]]*"\([0-9a-fA-F]*\)">$/\1/p' "$OUT")"
    committed_sha256="$(sed -n 's/^<!ENTITY packageSHA256[[:space:]]*"\([0-9a-fA-F]*\)">$/\1/p' "$OUT")"
    [ -z "$committed_md5" ] || [ "${committed_md5,,}" = "$PACKAGE_MD5" ] || { echo "$OUT packageMD5 does not match rebuilt $TGZ" >&2; exit 1; }
    [ -z "$committed_sha256" ] || [ "${committed_sha256,,}" = "$PACKAGE_SHA256" ] || { echo "$OUT packageSHA256 does not match rebuilt $TGZ" >&2; exit 1; }
  fi
  echo "built $TGZ + $PACKAGE_NAME ($PACKAGE_MD5, $PACKAGE_SHA256)"
  exit 0
fi

xml_escape() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g' -e "s/'/\\&apos;/g"; }
AUTHOR_XML="$(printf '%s' "$AUTHOR" | xml_escape)"
CHANGES_XML="$(printf '%s' "$changes" | xml_escape)"

cat > "$OUT" <<PLG
<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name          "${NAME}">
<!ENTITY author        "${AUTHOR_XML}">
<!ENTITY version       "${VERSION}">
<!ENTITY pluginVersion "${INTERNAL_VERSION}">
<!ENTITY releaseTag    "${RELEASE_TAG}">
<!ENTITY pluginURL     "${PLUGIN_URL}">
<!ENTITY packageName   "${PACKAGE_NAME}">
<!ENTITY packageURL    "${PACKAGE_URL}">
<!ENTITY packageMD5    "${PACKAGE_MD5}">
<!ENTITY packageSHA256 "${PACKAGE_SHA256}">
<!ENTITY plgdir        "/usr/local/emhttp/plugins/&name;">
<!ENTITY cfgdir        "/boot/config/plugins/&name;">
]>
<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        pluginURL="&pluginURL;"
        min="${MIN_UNRAID}"
        support="${SUPPORT_URL}"
        icon="ICON_NAME">

<CHANGES>
### &version;
${CHANGES_XML}
</CHANGES>

<!-- plugin package: Unraid downloads it to flash and verifies the MD5 -->
<FILE Name="&cfgdir;/&packageName;">
<URL>&packageURL;</URL>
<MD5>&packageMD5;</MD5>
</FILE>

<!-- install (entities are NOT expanded inside CDATA, so use literal paths) -->
<FILE Run="/bin/bash">
<INLINE><![CDATA[
set -e
PLGDIR="/usr/local/emhttp/plugins/${NAME}"
CFGDIR="/boot/config/plugins/${NAME}"
mkdir -p "\$CFGDIR"
echo "${PACKAGE_SHA256}  \$CFGDIR/${PACKAGE_NAME}" | sha256sum -c - || {
  echo "${NAME}: package SHA-256 mismatch; refusing privileged extraction"
  rm -f "\$CFGDIR/${PACKAGE_NAME}"
  exit 1
}
# Sweep older package versions off flash, keep this build's.
find "\$CFGDIR" -maxdepth 1 -name '${NAME}-*.tgz' ! -name '${PACKAGE_NAME}' -delete 2>/dev/null || true
# Replace the owned tmpfs code tree so removed files cannot survive an update.
rm -rf "\$PLGDIR"
mkdir -p "\$PLGDIR"
# Extract ONLY into the plugin dir; --no-same-owner forces root ownership.
# The .tgz stays on flash so the on-boot reinstall needs no download.
tar -xzf "\$CFGDIR/${PACKAGE_NAME}" --no-same-owner --no-overwrite-dir -C "\$PLGDIR"
chown -R root:root "\$PLGDIR"
find "\$PLGDIR" -type d -exec chmod 0755 {} +
# Preserve executable intent recorded in the package while normalizing modes.
find "\$PLGDIR" -type f ! -perm /111 -exec chmod 0644 {} +
find "\$PLGDIR" -type f   -perm /111 -exec chmod 0755 {} +
# Control scripts and emhttpd event hooks are executable by convention.
[ -d "\$PLGDIR/include" ] && find "\$PLGDIR/include" -name '*.sh' -exec chmod 0755 {} +
[ -d "\$PLGDIR/event" ]   && find "\$PLGDIR/event" -type f -exec chmod 0755 {} +
echo ""
echo "${NAME} ${VERSION} installed. Settings > MENU_LABEL > TITLE"
]]></INLINE>
</FILE>

<!-- remove -->
<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
PLGDIR="/usr/local/emhttp/plugins/${NAME}"
CFGDIR="/boot/config/plugins/${NAME}"
rm -rf "\$PLGDIR"
rm -f "\$CFGDIR"/${NAME}-*.tgz
echo "${NAME} removed. Config left in \$CFGDIR (delete manually to purge)."
]]></INLINE>
</FILE>

</PLUGIN>
PLG

echo "built $OUT + $TGZ + $PACKAGE_NAME (version $VERSION, tag $RELEASE_TAG, md5 $PACKAGE_MD5, sha256 $PACKAGE_SHA256)"
