<?php
/* Native Unraid settings form. parse_plugin_cfg reads the saved .cfg (empty []
   if none). Keep ONE $defaults array as the source of truth. Secrets do NOT
   belong here — write those via exec.php to a chmod-600 file. */
$plugin   = 'PLUGIN_ID';
$cfg      = parse_plugin_cfg($plugin);
$defaults = [ 'INTERVAL' => '30', 'MODE' => 'auto' ];
$PLUGIN_NAMESPACE_g = static fn($k) => htmlspecialchars($cfg[$k] ?? $defaults[$k] ?? '', ENT_QUOTES);
$PLUGIN_NAMESPACE_sel = static fn($k, $v) => (($cfg[$k] ?? $defaults[$k] ?? '') === $v) ? 'selected' : '';
?>
